<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <!--
    Minimal fake FolderIcon config fragment used solely by
    FolderTest#readOnlyViewerCannotEditLazyIconDescriptorFields (JENKINS-62218) to prove that
    the "readOnlyMode" jelly variable propagates into descriptor fragments rendered lazily via
    l:renderOnDemand (i.e. non-selected entries in a f:dropdownDescriptorSelector).
  -->
  <f:entry title="Extra Field" field="extraField">
    <f:textbox/>
  </f:entry>
</j:jelly>
